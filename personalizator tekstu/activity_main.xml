<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tlo1"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    tools:context=".MainActivity">

  <LinearLayout
      android:id="@+id/cardLayout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="@color/card_bg"
      android:gravity="center"
      android:orientation="vertical"
      android:padding="24dp">

    <TextView
        android:id="@+id/tvText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="przykładowy tekst"
        android:textColor="@color/text_color"
        android:textSize="26sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnChangeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="zmień tekst" />

    <Button
        android:id="@+id/btnChangeColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="zmień kolor tekstu" />

    <Button
        android:id="@+id/btnChangeBg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="zmień tło" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switchNight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="tryb nocny"
        android:textColor="@color/text_color" />

    <TextView
        android:id="@+id/tvAlphaLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="przezroczystość tekstu: 100%"
        android:textColor="@color/text_color" />

    <SeekBar
        android:id="@+id/seekAlpha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="100" />

  </LinearLayout>

</LinearLayout>